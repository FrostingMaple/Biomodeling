# biomodel-agent LLM 配置示例
#
# 说明：项目不会自动读取 .env 文件。请将下面的变量设置到 shell、
# CI secret 或部署环境中。

# 默认：中国科学技术大学大模型公共服务平台
BIOMODEL_PROVIDER=ustc
USTC_LLM_API_KEY=sk-你的APIKey
BIOMODEL_MODEL=deepseek-flash
BIOMODEL_BASE_URL=https://api.llm.ustc.edu.cn/v1

# Agent 调用可靠性（可选）
BIOMODEL_REQUEST_TIMEOUT=120
BIOMODEL_MAX_RETRIES=2
BIOMODEL_MAX_TOOL_ROUNDS=40
BIOMODEL_MAX_TOTAL_TOKENS=200000

# 可选：DeepSeek 官方接口
# BIOMODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-你的APIKey
# BIOMODEL_MODEL=deepseek-chat
# BIOMODEL_BASE_URL=https://api.deepseek.com/v1
