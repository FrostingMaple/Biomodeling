    {
      "id": "EXPR_MASS_ACTION",
      "canonical_name": "mass-action rate law",
      "aliases": [
        "law of mass action",
        "mass action kinetics"
      ],
      "domain": "chemical_kinetics",
      "expression": "v = k * product_i [X_i]^{n_i}",
      "latex": "v = k \\prod_i [X_i]^{n_i}",
      "parameters": [
        "PARAM_KON",
        "PARAM_KOFF"
      ],
      "response_variables": [
        "PARAM_REACTION_FLUX"
      ],
      "assumptions": [
        "Elementary reactions are treated as stochastic or deterministic events with rate proportional to reactant abundance."
      ],
      "related_models": [
        "MODEL_MASS_ACTION",
        "MODEL_CHEMICAL_REACTION_NETWORK"
      ],
      "source_ids": [
        "biomodels",
        "sabio_rk"
      ],
      "confidence": "high",
      "notes": ""
    },
    {
      "id": "EXPR_MICHAELIS_MENTEN",
      "canonical_name": "Michaelis-Menten rate law",
      "aliases": [
        "Michaelis-Menten equation",
        "Michaelis Menten kinetics",
        "saturation kinetics"
      ],
      "domain": "enzyme_kinetics",
      "expression": "v = Vmax * [S] / (Km + [S])",
      "latex": "v = \\frac{V_{max}[S]}{K_m+[S]}",
      "parameters": [
        "PARAM_VMAX",
        "PARAM_KM",
        "PARAM_SUBSTRATE_CONCENTRATION"
      ],
      "response_variables": [
        "PARAM_REACTION_FLUX"
      ],
      "assumptions": [
        "Single-substrate enzyme reaction; quasi-steady-state assumption for enzyme-substrate complex; no inhibition or cooperativity."
      ],
      "related_models": [
        "MODEL_MICHAELIS_MENTEN",
        "MODEL_ENZYME_KINETICS"
      ],
      "source_ids": [
        "classic_mm",
        "brenda",
        "sabio_rk",
        "biomodels"
      ],
      "confidence": "high",
      "notes": ""
    },
